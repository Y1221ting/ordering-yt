/* pages/myorder/myorder.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf7f0;
}

/* 标签栏 */
.tabs {
  background: #fdfaf3;
  display: flex;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
}

.tab-text {
  font-size: 30rpx;
  color: #6b7a72;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #5fc4a3;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #5fc4a3;
  border-radius: 3rpx;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx;
}

.order-item {
  background: #fdfaf3;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e3dbc9;
}

.order-user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #fdfaf3;
}

.user-info-text {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  color: #2f3632;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.user-sub {
  font-size: 24rpx;
  color: #9aa39d;
}

.order-type {
  font-size: 30rpx;
  color: #2f3632;
  font-weight: bold;
}

.order-status {
  font-size: 26rpx;
  color: #5fc4a3;
  padding: 6rpx 20rpx;
  background: rgba(229, 77, 66, 0.1);
  border-radius: 20rpx;
}

.order-status.cancel {
  color: #9aa39d;
  background: #fdfaf3;
}

/* 订单内容 */
.order-content {
  padding: 30rpx;
}

/* 点餐订单商品列表 */
.goods-list {
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e3dbc9;
}

.goods-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #2f3632;
  margin-bottom: 10rpx;
}

.goods-sku {
  font-size: 24rpx;
  color: #38b2ac;
  margin-bottom: 8rpx;
}

/* 商品标签 */
.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #5fc4a3;
  background: rgba(229, 77, 66, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(229, 77, 66, 0.3);
}

.goods-detail {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-count {
  font-size: 26rpx;
  color: #9aa39d;
}

/* 订单底部 */
.order-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #e3dbc9;
  text-align: right;
}

.order-info {
  text-align: right;
  margin-bottom: 15rpx;
}

.order-taste {
  font-size: 24rpx;
  color: #38b2ac;
  font-weight: 500;
  margin-top: 5rpx;
}

.order-remark {
  font-size: 24rpx;
  color: #38b2ac;
  font-weight: 500;
  margin-top: 5rpx;
}

/* 高级版视觉覆盖 */
.page {
  background: linear-gradient(180deg, #faf7f0 0%, #faf7f0 240rpx, #faf7f0 100%);
}

.tabs {
  margin: 20rpx 20rpx 0;
  padding: 6rpx;
  border-radius: 16rpx;
  border-bottom: none;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.tab-item {
  padding: 24rpx 0;
  border-radius: 12rpx;
}

.tab-item.active {
  background: #fff4f0;
}

.tab-item.active .tab-text {
  color: #5fc4a3;
}

.tab-line {
  bottom: 8rpx;
  background: #5fc4a3;
}

.order-list {
  padding: 20rpx;
}

.order-item {
  border-radius: 16rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.order-header {
  border-bottom-color: #e3dbc9;
}

.user-avatar {
  border: 4rpx solid #fdfaf3;
  box-shadow: 0 8rpx 18rpx rgba(27, 36, 48, 0.08);
}

.order-type {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4f0;
  color: #5fc4a3;
  font-size: 24rpx;
}

.user-name,
.goods-name {
  color: #2f3632;
}

.user-sub,
.goods-count {
  color: #9aa39d;
}

.goods-image {
  background: #fdfaf3;
}

.goods-sku,
.order-remark {
  color: #1f9d8a;
}

.order-footer {
  border-top-color: #e3dbc9;
  background: #fdfaf3;
}

<!--pages/myorder/myorder.wxml-->
<view class="page">
  <!-- 顶部切换：今天（共享菜单） / 全部（历史） -->
  <view class="tabs">
    <view
      class="tab-item {{viewMode === item.mode ? 'active' : ''}}"
      wx:for="{{viewTabs}}"
      wx:key="index"
      bindtap="switchView"
      data-mode="{{item.mode}}">
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-line" wx:if="{{viewMode === item.mode}}"></view>
    </view>
  </view>

  <!-- 订单列表（全家共享） -->
  <view class="order-list">
    <view class="order-item" wx:for="{{orderList}}" wx:key="_id">
      <!-- 订单头部：谁点的 -->
      <view class="order-header">
        <view class="order-user-info">
          <image class="user-avatar" src="{{item.orderUserAvatar || '/images/tabBar/me.png'}}" mode="aspectFill"></image>
          <view class="user-info-text">
            <view class="user-name">{{item.orderUserNickName}}</view>
            <view class="user-sub">{{item.createTimeText}}</view>
          </view>
        </view>
        <view class="order-type">
          <text>点餐</text>
        </view>
      </view>

      <!-- 点餐内容 -->
      <view class="order-content">
        <view class="goods-list">
          <view class="goods-item" wx:for="{{item.goods}}" wx:for-item="goods" wx:key="index">
            <image class="goods-image" src="{{goods.dishImage}}" mode="aspectFill"></image>
            <view class="goods-info">
              <view class="goods-name">{{goods.dishName}}</view>
              <view class="goods-sku" wx:if="{{goods.skuName}}">{{goods.skuName}}</view>
              <!-- 显示标签 -->
              <view class="goods-tags" wx:if="{{goods.tags && goods.tags.length > 0}}">
                <van-tag type="success" wx:for="{{goods.tags}}" wx:key="index" wx:for-item="tagVal">{{tagVal}}</van-tag>
              </view>
              <view class="goods-detail">
                <text class="goods-count">x{{goods.count}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单底部：口味与备注 -->
      <view class="order-footer">
        <view class="order-info">
          <view class="order-taste" wx:if="{{item.tasteText}}">
            口味：{{item.tasteText}}
          </view>
          <view class="order-remark" wx:if="{{item.remark}}">
            备注：{{item.remark}}
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <van-empty wx:if="{{orderList.length === 0}}" description="{{viewMode === 'today' ? '今天还没人点菜哦' : '还没有订单'}}" />
  </view>
</view>

<!--pages/admin/order/order.wxml-->
<view class="page">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <van-tabs active="{{orderType}}" bind:change="onChange" color="#5fc4a3" swipeable="{{false}}">
      <van-tab title="全部订单" />
      <van-tab title="点餐订单" />
    </van-tabs>

    <!-- 时间段筛选 -->
    <view class="time-filter">
      <view class="time-tabs">
        <view
          class="time-tab {{timeRange === index ? 'active' : ''}}"
          wx:for="{{timeOptions}}"
          wx:key="index"
          bindtap="onTimeRangeChange"
          data-index="{{index}}">{{item}}</view>
      </view>
      <view class="custom-picker" wx:if="{{timeRange === 5}}">
        <picker mode="date" value="{{customStart}}" bindchange="onCustomStartChange">
          <view class="picker-box {{customStart ? '' : 'empty'}}">{{customStart || '开始日期'}}</view>
        </picker>
        <text class="picker-sep">至</text>
        <picker mode="date" value="{{customEnd}}" bindchange="onCustomEndChange">
          <view class="picker-box {{customEnd ? '' : 'empty'}}">{{customEnd || '结束日期'}}</view>
        </picker>
      </view>
    </view>

    <!-- 视图切换 -->
    <view class="view-switch">
      <view class="view-btn {{viewMode === 'list' ? 'active' : ''}}" bindtap="onViewModeChange" data-mode="list">流水</view>
      <view class="view-btn {{viewMode === 'summary' ? 'active' : ''}}" bindtap="onViewModeChange" data-mode="summary">分类汇总</view>
    </view>

    <view class="refresh-bar">
      <view class="refresh-btn" bindtap="refreshOrders">刷新</view>
      <text class="refresh-tip">每 10 秒自动刷新</text>
    </view>
  </view>

  <!-- 流水视图：订单列表 -->
  <view class="order-list" wx:if="{{viewMode === 'list'}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id">
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-user-info" wx:if="{{item.userAvatar}}">
          <image class="user-avatar" src="{{item.userAvatar || '/images/my.png'}}" mode="aspectFill"></image>
          <view class="user-info-text">
            <view class="user-name">{{item.userNickName || '未设置昵称'}}</view>
          </view>
        </view>
        <view class="order-type">
          <text>点餐</text>
        </view>
      </view>

      <!-- 点餐订单内容 -->
      <view class="order-content" wx:if="{{item.type === 'order'}}">
        <view class="goods-list">
          <view class="goods-item" wx:for="{{item.goods}}" wx:for-item="goods" wx:key="index">
            <image class="goods-image" src="{{goods.dishImage}}" mode="aspectFill"></image>
            <view class="goods-info">
              <view class="goods-name">{{goods.dishName}}</view>
              <view class="goods-sku" wx:if="{{goods.skuName}}">{{goods.skuName}}</view>
              <!-- 显示标签 -->
              <view class="goods-tags" wx:if="{{goods.tags && goods.tags.length > 0}}">
                <!-- <text class="tag-text" wx:for="{{goods.tags}}" wx:key="index" wx:for-item="tagVal">
                  {{tagVal}}
                </text> -->
                <van-tag type="success" wx:for="{{goods.tags}}" wx:key="index" wx:for-item="tagVal">{{tagVal}}</van-tag>
              </view>
              <view class="goods-detail">
                <text class="goods-count">x{{goods.count}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-info">
          <view class="order-time">
            {{item.createTimeText}}
          </view>
          <view class="order-taste" wx:if="{{item.tasteText}}">
            口味：{{item.tasteText}}
          </view>
          <view class="order-table-code" wx:if="{{item.remark}}">
            备注：{{item.remark}}
          </view>
        </view>
        <view class="action-btns">
          <!-- <view class="action-btn delete" bindtap="deleteOrder" data-order="{{item}}" catchtap="stopPropagation">删除</view> -->
        </view>
      </view>
    </view>

    <van-empty wx:if="{{orders.length === 0}}" description="暂无订单数据" />
  </view>

  <!-- 分类汇总视图 -->
  <view class="summary-view" wx:if="{{viewMode === 'summary'}}">
    <view class="summary-stats">
      <text class="summary-stats-text">
        共 {{summaryStats.orderCount}} 个订单 · {{summaryStats.dishCount}} 份菜
      </text>
    </view>

    <view class="summary-card" wx:for="{{summaryList}}" wx:key="categoryName">
      <view class="summary-card-head">
        <text class="summary-cat-name">{{item.categoryName}}</text>
        <text class="summary-cat-count">{{item.dishes.length}} 道菜</text>
      </view>
      <view
        class="summary-dish"
        wx:for="{{item.dishes}}"
        wx:for-item="dish"
        wx:key="name">
        <text class="summary-dish-name">{{dish.name}}</text>
        <text class="summary-dish-count">×{{dish.count}}</text>
      </view>
    </view>

    <van-empty wx:if="{{summaryList.length === 0}}" description="该时段没有点餐订单" />
  </view>

</view>


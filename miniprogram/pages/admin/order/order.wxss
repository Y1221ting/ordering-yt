/* pages/admin/order/order.wxss */
.page {
  min-height: 100vh;
  background: #faf7f0;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 筛选栏 */
.filter-bar {
  background: white;
  border-radius: 16rpx;
  padding: 10rpx 20rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.refresh-bar {
  margin-top: 10rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 15rpx;
}

.refresh-btn {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #5fc4a3;
  color: #5fc4a3;
  font-size: 24rpx;
}

.refresh-tip {
  font-size: 22rpx;
  color: #9aa39d;
}

/* 时间段筛选 */
.time-filter {
  margin-top: 16rpx;
}

.time-tabs {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding: 4rpx 0 8rpx;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.time-tab {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b7a72;
  background: #fdfaf3;
  border: 1rpx solid #e3dbc9;
}

.time-tab.active {
  color: #fff;
  background: #5fc4a3;
  border-color: #5fc4a3;
  font-weight: 600;
}

.custom-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.picker-box {
  flex: 1;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #fdfaf3;
  border: 1rpx solid #e3dbc9;
  font-size: 26rpx;
  color: #2f3632;
  text-align: center;
}

.picker-box.empty {
  color: #9aa39d;
}

.picker-sep {
  font-size: 24rpx;
  color: #9aa39d;
}

/* 视图切换 */
.view-switch {
  display: flex;
  margin-top: 14rpx;
  background: #fdfaf3;
  border-radius: 12rpx;
  padding: 4rpx;
  border: 1rpx solid #e3dbc9;
}

.view-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #6b7a72;
  border-radius: 10rpx;
}

.view-btn.active {
  background: #fff;
  color: #5fc4a3;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(27, 36, 48, 0.08);
}

/* 分类汇总视图 */
.summary-view {
  padding: 0;
}

.summary-stats {
  background: white;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.summary-stats-text {
  font-size: 26rpx;
  color: #5fc4a3;
  font-weight: 600;
}

.summary-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.summary-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx;
  background: #fff4f0;
  border-bottom: 1rpx solid #e3dbc9;
}

.summary-cat-name {
  font-size: 30rpx;
  color: #2f3632;
  font-weight: bold;
}

.summary-cat-count {
  font-size: 24rpx;
  color: #9aa39d;
}

.summary-dish {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f0ede4;
}

.summary-dish:last-child {
  border-bottom: none;
}

.summary-dish-name {
  font-size: 28rpx;
  color: #2f3632;
}

.summary-dish-count {
  font-size: 26rpx;
  color: #5fc4a3;
  font-weight: 600;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx;
}

.order-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e3dbc9;
}

.order-user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #fdfaf3;
}

.user-info-text {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  color: #2f3632;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.order-type {
  font-size: 30rpx;
  color: #2f3632;
  font-weight: bold;
}

/* 订单内容 */
.order-content {
  padding: 30rpx;
}

/* 点餐订单商品列表 */
.goods-list {
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e3dbc9;
}

.goods-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #2f3632;
  margin-bottom: 10rpx;
}

.goods-sku {
  font-size: 24rpx;
  color: #38b2ac;
  margin-bottom: 8rpx;
}

/* 商品标签 */
.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #5fc4a3;
  background: rgba(229, 77, 66, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(229, 77, 66, 0.3);
}

.goods-detail {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-count {
  font-size: 26rpx;
  color: #9aa39d;
}

/* 订单底部 */
.order-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #e3dbc9;
  text-align: right;
}

.order-info {
  text-align: right;
  margin-bottom: 15rpx;
}

.order-time {
  font-size: 24rpx;
  color: #9aa39d;
  margin-bottom: 8rpx;
}

.order-table-code {
  font-size: 24rpx;
  color: #38b2ac;
  font-weight: 500;
  margin-top: 5rpx;
}

.action-btns {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 12rpx 30rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  text-align: center;
}

.action-btn.delete {
  background: rgba(245, 108, 108, 0.1);
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
}

/* 高级版视觉覆盖 */
.page {
  background: linear-gradient(180deg, #faf7f0 0%, #faf7f0 240rpx, #faf7f0 100%);
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.filter-bar {
  border-radius: 16rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.refresh-bar {
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.refresh-btn {
  border-color: rgba(95, 196, 163, 0.34);
  color: #5fc4a3;
  background: #fff4f0;
}

.refresh-tip {
  color: #9aa39d;
}

.order-list {
  padding: 0;
}

.order-item {
  border-radius: 16rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.order-header {
  padding: 28rpx;
  border-bottom-color: #e3dbc9;
}

.user-avatar {
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(27, 36, 48, 0.08);
}

.user-name,
.order-type,
.goods-name {
  color: #2f3632;
}

.order-time {
  color: #9aa39d;
}

.order-type {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4f0;
  color: #5fc4a3;
  font-size: 24rpx;
}

.goods-image {
  background: #fdfaf3;
}

.goods-sku,
.order-table-code {
  color: #1f9d8a;
}

.order-footer {
  border-top-color: #e3dbc9;
  background: #fdfaf3;
}



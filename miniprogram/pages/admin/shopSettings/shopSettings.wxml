<view class="page">
  <view class="preview-band">
    <view class="preview-label">
      <text class="cuIcon-attention"></text>
      <text>点餐端预览</text>
    </view>
    <view class="store-preview">
      <view class="store-mark cuIcon-shopfill"></view>
      <view class="store-copy">
        <view class="store-name">{{shopName || '家庭名称'}}</view>
        <view class="store-welcome">{{welcomeText || '欢迎回家'}}</view>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="section-heading">
      <text class="heading-icon cuIcon-shop"></text>
      <text>家庭信息</text>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text>家庭名称</text>
        <text class="required">*</text>
      </view>
      <input
        class="form-input"
        value="{{shopName}}"
        maxlength="20"
        placeholder="请输入家庭名称"
        bindinput="onShopNameInput"
        confirm-type="done"
      />
      <view class="field-counter input-counter">{{shopName.length}} / 20</view>
    </view>

    <view class="form-item">
      <view class="form-label">
        <text>欢迎词</text>
        <text class="required">*</text>
      </view>
      <textarea
        class="form-textarea"
        value="{{welcomeText}}"
        maxlength="48"
        placeholder="例如：欢迎回家，今天想吃什么？"
        bindinput="onWelcomeTextInput"
      ></textarea>
      <view class="field-counter">{{welcomeText.length}} / 48</view>
    </view>
  </view>

  <!-- 辣味选项 -->
  <view class="form-section">
    <view class="section-heading">
      <text class="heading-icon cuIcon-spicyfill"></text>
      <text>辣味选项</text>
    </view>
    <view class="option-note">家人点菜时从中选择辣度（默认爆辣）</view>
    <view class="option-chips">
      <view class="option-chip" wx:for="{{tasteOptions}}" wx:key="*this">
        <text class="option-chip-text">{{item}}</text>
        <text
          class="option-chip-remove"
          catchtap="removeTasteOption"
          data-index="{{index}}">×</text>
      </view>
    </view>
    <view class="option-add-row">
      <input
        class="option-input"
        placeholder="如：变态辣"
        value="{{newTaste}}"
        bindinput="onNewTasteInput"
        confirm-type="done"
        bindconfirm="addTasteOption"
      />
      <view class="option-add-btn" bindtap="addTasteOption" hover-class="control-pressed">
        <text class="cuIcon-add"></text>
        <text>添加</text>
      </view>
    </view>
  </view>

  <!-- 忌口选项 -->
  <view class="form-section">
    <view class="section-heading">
      <text class="heading-icon cuIcon-close"></text>
      <text>忌口选项</text>
    </view>
    <view class="option-note">家人点菜时可勾选不吃的配料，可多选</view>
    <view class="option-chips">
      <view class="option-chip" wx:for="{{avoidOptions}}" wx:key="*this">
        <text class="option-chip-text">{{item}}</text>
        <text
          class="option-chip-remove"
          catchtap="removeAvoidOption"
          data-index="{{index}}">×</text>
      </view>
    </view>
    <view class="option-add-row">
      <input
        class="option-input"
        placeholder="如：花椒"
        value="{{newAvoid}}"
        bindinput="onNewAvoidInput"
        confirm-type="done"
        bindconfirm="addAvoidOption"
      />
      <view class="option-add-btn" bindtap="addAvoidOption" hover-class="control-pressed">
        <text class="cuIcon-add"></text>
        <text>添加</text>
      </view>
    </view>
  </view>

  <view class="save-bar">
    <view
      class="save-btn {{saving ? 'is-saving' : ''}}"
      bindtap="saveSettings"
      hover-class="control-pressed">
      <text class="cuIcon-check"></text>
      <text>{{saving ? '保存中' : '保存设置'}}</text>
    </view>
  </view>
</view>

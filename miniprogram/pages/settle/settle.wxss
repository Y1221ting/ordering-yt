/* pages/settle/settle.wxss */
.page {
  min-height: 100vh;
  background: #faf7f0;
  box-sizing: border-box;
  padding-bottom: calc(164rpx + env(safe-area-inset-bottom));
}

.section {
  background: #fdfaf3;
  margin: 20rpx 20rpx 0;
  padding: 30rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section:first-child {
  margin-top: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f3632;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  letter-spacing: 0;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title-wrapper .section-title {
  padding: 0;
  margin-bottom: 0;
}

.edit-order-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #5fc4a3;
  border: 2rpx solid #5fc4a3;
  border-radius: 8rpx;
  background: #fdfaf3;
}

.remark-input {
  width: auto;
  display: block;
  min-height: 150rpx;
  margin: 0 30rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  color: #2f3632;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 桌码显示 */
.table-code-wrapper {
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.table-code-display {
  flex: 1;
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.table-code-value {
  font-size: 30rpx;
  color: #2f3632;
  font-weight: 500;
}

.table-code-bold {
  font-weight: 700;
  font-size: 36rpx;
  color: #2f3632;
}

.table-code-empty {
  color: #5fc4a3;
  font-size: 30rpx;
  font-weight: 600;
}

.table-code-actions {
  margin-left: 20rpx;
}

.change-table-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #5fc4a3;
  border: 2rpx solid #5fc4a3;
  border-radius: 8rpx;
  background: #fdfaf3;
  cursor: pointer;
  user-select: none;
}

/* 商品列表 */
.goods-list {
  padding: 0 30rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-item:active {
  background-color: #fafafa;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #fdfaf3;
  overflow: hidden;
}

.goods-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa39d;
  font-size: 22rpx;
}

.goods-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140rpx;
}

.goods-name {
  font-size: 30rpx;
  color: #2f3632;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.goods-sku {
  font-size: 24rpx;
  color: #38b2ac;
  margin-bottom: 8rpx;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.goods-price-count {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.goods-count {
  font-size: 24rpx;
  color: #9aa39d;
}

/* 支付方式卡片 */
.pay-method-list {
  padding: 0 30rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.payment-section {
  margin-bottom: 24rpx;
}

.pay-method-item {
  flex: 1;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  padding: 20rpx;
  transition: all 0.3s;
  min-width: 0;
}

.pay-method-item.active {
  background: rgba(229, 77, 66, 0.08);
  border-color: #5fc4a3;
}

.pay-method-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.pay-method-left {
  width: 100%;
}

.pay-method-title {
  font-size: 26rpx;
  color: #2f3632;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.pay-method-item.active .pay-method-title {
  color: #5fc4a3;
  font-weight: 600;
}

.pay-method-desc {
  font-size: 22rpx;
  color: #9aa39d;
  line-height: 1.4;
}

.pay-method-item.active .pay-method-desc {
  color: #6b7a72;
}

.pay-method-radio {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 12rpx;
}

.pay-method-radio.checked {
  border-color: #5fc4a3;
  background: #5fc4a3;
}

.radio-dot {
  width: 16rpx;
  height: 16rpx;
  background: #fdfaf3;
  border-radius: 50%;
}

/* 底部提交区域 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fdfaf3;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.submit-btn {
  width: 240rpx;
  min-width: 240rpx;
  max-width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #5fc4a3;
  color: white;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(229, 77, 66, 0.3);
  transition: all 0.3s;
}

.submit-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.submit-btn.disabled {
  background-color: #ccc;
  color: #9aa39d;
  box-shadow: none;
  opacity: 0.6;
}

.submit-btn.disabled:active {
  opacity: 0.6;
  transform: none;
}

/* 高级版视觉覆盖 */
.page {
  padding-top: 20rpx;
  background: linear-gradient(180deg, #faf7f0 0%, #faf7f0 260rpx, #faf7f0 100%);
}

.section {
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.section-title {
  color: #2f3632;
  letter-spacing: 0;
}

.edit-order-btn,
.change-table-btn {
  color: #5fc4a3;
  border-color: rgba(95, 196, 163, 0.32);
  background: #fff4f0;
  border-radius: 999rpx;
}

.remark-input,
.pay-method-item {
  background: #fdfaf3;
  border: 1rpx solid #e3dbc9;
}

.table-code-bold,
.goods-name,
.pay-method-title {
  color: #2f3632;
}

.pay-method-desc,
.goods-count {
  color: #9aa39d;
}

.goods-image {
  border-radius: 14rpx;
  background: #fdfaf3;
}

.goods-sku {
  color: #1f9d8a;
}

.pay-method-item.active {
  background: #fff4f0;
  border-color: rgba(95, 196, 163, 0.34);
}

.pay-method-item.active .pay-method-title {
  color: #5fc4a3;
}

.pay-method-radio.checked {
  border-color: #5fc4a3;
  background: #5fc4a3;
}

.footer {
  border-top-color: #e3dbc9;
  box-shadow: 0 -12rpx 34rpx rgba(27, 36, 48, 0.1);
}

.submit-btn {
  background: linear-gradient(135deg, #2e4a40 0%, #3f9d81 56%, #5fc4a3 100%);
  box-shadow: 0 12rpx 26rpx rgba(95, 196, 163, 0.22);
}

<!--pages/settle/settle.wxml-->
<view class="page">
  <!-- 口味选择 -->
  <view class="section" wx:if="{{tasteOptions.length > 0 || avoidOptions.length > 0}}">
    <view class="section-title">口味</view>
    <view class="taste-group">
      <view class="taste-options" wx:if="{{tasteOptions.length > 0}}">
        <view
          class="taste-option {{selectedTaste === item ? 'selected' : ''}}"
          wx:for="{{tasteOptions}}"
          wx:key="*this"
          bindtap="selectTaste"
          data-taste="{{item}}">{{item}}</view>
      </view>
      <view class="avoid-label" wx:if="{{avoidOptions.length > 0}}">忌口（可多选）</view>
      <view class="avoid-options" wx:if="{{avoidOptions.length > 0}}">
        <view
          class="avoid-option {{selectedAvoids.indexOf(item) > -1 ? 'selected' : ''}}"
          wx:for="{{avoidOptions}}"
          wx:key="*this"
          bindtap="toggleAvoid"
          data-avoid="{{item}}">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">备注（选填）</view>
    <textarea
      class="remark-input"
      placeholder="还有什么想说的，写在这里"
      maxlength="120"
      value="{{remark}}"
      bindinput="onRemarkInput"
    />
  </view>

  <!-- 订单商品列表 -->
  <view class="section">
    <view class="section-title-wrapper">
      <text class="section-title">订单明细</text>
      <view class="edit-order-btn" bind:tap="editOrder">
        修改
      </view>
    </view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{orderGoods}}" wx:key="cartKey">
        <image wx:if="{{item.dishImage}}" class="goods-image" src="{{item.dishImage}}" mode="aspectFill"></image>
        <view wx:else class="goods-image goods-image-placeholder">暂无图片</view>
        <view class="goods-info">
          <view class="goods-name">{{item.dishName}}</view>
          <view class="goods-sku" wx:if="{{item.skuName}}">{{item.skuName}}</view>
          <view class="goods-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <van-tag
              type="success"
              wx:for="{{item.tags}}"
              wx:key="index"
              wx:for-item="tagVal">
              {{tagVal}}
            </van-tag>
          </view>
          <view class="goods-count-row">
            <text class="goods-count">×{{item.count}}</text>
          </view>
        </view>
      </view>

      <van-empty wx:if="{{orderGoods.length === 0}}" description="菜篮还空着，去挑几道吧" />
    </view>
  </view>

  <!-- 底部提交按钮 -->
  <view class="footer">
    <view
      class="submit-btn {{submitting || !canSubmit ? 'disabled' : ''}}"
      bind:tap="submitOrder">
      <text wx:if="{{submitting}}">提交中...</text>
      <text wx:else>就点这些</text>
    </view>
  </view>
</view>

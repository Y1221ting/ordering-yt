/**app.wxss**/
@import './components/colorui/animation.wxss';
@import './components/colorui/icon.wxss';
@import './components/colorui/main.wxss';
@import './components/colorui/vertical-nav.wxss';

/* 全局红色主题样式 */
page {
  --theme-color: #5fc4a3;
  --theme-color-dark: #2f8a6d;
  --theme-color-light: #8fd8bc;
  --theme-soft: #fff4f0;
  --theme-warm: #fff8f3;
  --accent-color: #1f9d8a;
  --warning-color: #c77a18;
  --success-color: #2f9e5b;
  --text-main: #2f3632;
  --text-sub: #6b7a72;
  --text-muted: #9aa39d;
  --line-color: #e3dbc9;
  --card-bg: #ffffff;
  --page-bg: #faf7f0;
  --card-shadow: 0 12rpx 34rpx rgba(27, 36, 48, 0.07);
  --soft-shadow: 0 8rpx 22rpx rgba(95, 196, 163, 0.16);
  --theme-gradient: linear-gradient(135deg, #2e4a40 0%, #3f9d81 56%, #5fc4a3 100%);
  /* 「青竹晚山」主题变量 */
  --ink: #2f3632;          /* 墨色：标题、主要文字 */
  --ink-deep: #2e4a40;     /* 墨青：导航栏、分类选中、侧边栏 */
  --paper: #faf7f0;        /* 宣纸：页面底色 */
  --paper-card: #fdfaf3;   /* 宣纸：卡片面 */
  --hair: #e3dbc9;         /* 淡墨：描边、分隔线 */
  --seal: #b03a2e;         /* 朱砂：印章、点缀 */
  background-color: #faf7f0;
  color: #2f3632;
  font-size: 28rpx;
}

.container {
  padding: 20rpx;
}

/* 主题按钮 */
.btn-theme {
  background: var(--theme-gradient);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  box-shadow: var(--soft-shadow);
}

.btn-theme-plain {
  background: white;
  color: var(--theme-color);
  border: 2rpx solid rgba(95, 196, 163, 0.26);
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid rgba(34, 37, 43, 0.05);
}

/* 标签 */
.tag-red {
  background: var(--theme-color);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

/* 价格样式 */
.price {
  color: var(--theme-color);
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
}

.price-num {
  font-size: 36rpx;
}

/* 徽章 */
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: var(--theme-color);
  color: white;
  border-radius: 50%;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  padding: 0 8rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--line-color);
  margin: 20rpx 0;
}

input,
textarea {
  box-sizing: border-box;
}

.add-btn,
.save-btn,
.bind-btn,
.refresh-btn,
.action-btn,
.modal-btn,
.submit-btn,
.recharge-btn,
.cart-settle-btn,
.settle-btn,
.add-cart-btn {
  letter-spacing: 0;
}

.modal-dialog {
  border-radius: 16rpx !important;
  box-shadow: 0 30rpx 90rpx rgba(18, 24, 33, 0.22);
}

.form-input,
.form-textarea,
.password-input,
.search-input,
.option-input {
  border-color: #e3dbc9 !important;
  border-radius: 12rpx !important;
  background: #fdfaf3;
}

.section-title,
.header-title,
.modal-title {
  letter-spacing: 0;
}
